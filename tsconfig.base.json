{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@aulify/ui": ["packages/ui/src"],
      "@aulify/design-system": ["packages/design-system/src"],
      "@aulify/shared-types": ["packages/shared-types/src"],
      "@aulify/validation": ["packages/validation/src"],
      "@aulify/firebase-admin": ["packages/firebase-admin/src"],
      "@aulify/api-client": ["packages/api-client/src"],
      "@aulify/config": ["packages/config/src"]
    }
  }
}
